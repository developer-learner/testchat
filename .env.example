# .env.example — copy to .env and fill in. NEVER commit .env (.gitignore covers it).
#
# testchat reads all runtime config from the environment. src/main.py calls
# load_dotenv() at startup (before the routers import), so anything set here is
# picked up automatically. Every var below has a working default in code; set a
# var only to override that default.

# --- Chat LLM (src/services/llm.py) ---
# The chat core is wrapper-agnostic: point it at anything serving an
# OpenAI-compatible /v1/chat/completions. The canonical endpoint is the
# Vortex daemon (:9000), which load-gates and proxies local servers; the
# requested LLM_MODEL must be loaded in Vortex or the proxy answers 404
# and the UI shows the fallback reply. A bare LM Studio (:1234) endpoint
# still works as a fallback.
LLM_ENDPOINT=http://127.0.0.1:9000/v1/chat/completions
# Public id of a model loaded in Vortex (see GET :9000/v1/models).
# LM Studio fallback: LLM_MODEL=local-model
LLM_MODEL=qwen3.8-flash-next-4-8bit
LLM_SYSTEM_PROMPT=
LLM_TIMEOUT_SECONDS=120

# --- Script-model servers (src/services/models.py) ---
# Base URLs of the process-managed local model servers. Defaults match the
# reserved ports (8600 nemotron, 8000 deepseek, 8005 deepseek-0731). Do NOT run
# the app itself on 8000 — that port belongs to the DeepSeek script model.
NEMOTRON_URL=http://localhost:8600
DS4_URL=http://127.0.0.1:8000
DS4_0731_URL=http://127.0.0.1:8005
