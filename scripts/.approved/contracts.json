"src.services.models:load_nemotron",
"src.services.models:unload_nemotron",
"src.services.models:is_nemotron_loaded"
],
"routes": [
{ "id": "route:GET /", "method": "GET", "path": "/" },
{ "id": "route:POST /api/v1/chat", "method": "POST", "path": "/api/v1/chat" },
{ "id": "route:GET /api/v1/models", "method": "GET", "path": "/api/v1/models" },
{ "id": "route:POST /api/v1/nemotron/load", "method": "POST", "path": "/api/v1/nemotron/load" },
{ "id": "route:POST /api/v1/nemotron/unload", "method": "POST", "path": "/api/v1/nemotron/unload" }
],
"schemas": [
{ "id": "schema:ChatRequest", "fields": { "message": "string", "history": "array of HistoryEntry, optional, default []", "model": "string, optional, default null" } },
{ "id": "schema:HistoryEntry", "fields": { "role": "string, literal 'user' or 'assistant'", "content": "string" } },
{ "id": "schema:SSEToken", "fields": { "event": "literal 'token'", "content": "string" } },
{ "id": "schema:SSEThink", "fields": { "event": "literal 'think'", "content": "string" } },
{ "id": "schema:SSEDone", "fields": { "event": "literal 'done'" } },
{ "id": "schema:SSEError", "fields": { "event": "literal 'error'", "message": "string" } },
{ "id": "schema:ModelInfo", "fields": { "id": "string", "source": "string, literal 'lmstudio' or 'nemotron'" } },
{ "id": "schema:ModelsListResponse", "fields": { "models": "array of ModelInfo" } },
{ "id": "schema:NemotronLoadResponse", "fields": { "status": "string, literal 'loaded' or 'error'", "message": "string, optional" } },
{ "id": "schema:NemotronUnloadResponse", "fields": { "status": "string, literal 'unloaded' or 'error'", "message": "string, optional" } }
],
"errors": [
{ "id": "error:422-validation", "status": 422 },
{ "id": "error:503-nemotron-unavailable", "status": 503 }
]
}
