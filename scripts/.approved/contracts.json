   "id": "route:GET /api/v1/status",
   "method": "GET",
   "path": "/api/v1/status"
  }
 ],
 "schemas": [
  {
   "id": "schema:ChatRequest",
   "fields": {
    "message": "string",
    "history": "array of HistoryEntry, optional, default []",
    "model": "string, optional, default null"
   }
  },
  {
   "id": "schema:HistoryEntry",
   "fields": {
    "role": "string, literal 'user' or 'assistant'",
    "content": "string"
   }
  },
  {
   "id": "schema:SSEToken",
   "fields": {
    "event": "literal 'token'",
    "content": "string"
   }
  },
  {
   "id": "schema:SSEThink",
   "fields": {
    "event": "literal 'think'",
    "content": "string"
   }
  },
  {
   "id": "schema:SSEDone",
   "fields": {
    "event": "literal 'done'"
   }
  },
  {
   "id": "schema:SSEError",
   "fields": {
    "event": "literal 'error'",
    "message": "string"
   }
  },
  {
   "id": "schema:ModelInfo",
   "fields": {
    "id": "string",
    "source": "string, literal 'lmstudio' or 'nemotron'"
   }
  },
  {
   "id": "schema:ModelsListResponse",
   "fields": {
    "models": "array of ModelInfo"
   }
  },
  {
   "id": "schema:NemotronLoadResponse",
   "fields": {
    "status": "string, literal 'loaded' or 'error'",
    "message": "string, optional"
   }
  },
  {
   "id": "schema:NemotronUnloadResponse",
   "fields": {
    "status": "string, literal 'unloaded' or 'error'",
    "message": "string, optional"
   }
  },
  {
   "id": "schema:ThreadSnapshot",
   "fields": {
    "id": "integer",
    "title": "string",
    "messages": "array of HistoryEntry",
    "model": "string, may be empty",
    "locked": "boolean"
   }
  },
  {
   "id": "schema:ThreadsPayload",
   "fields": {
    "threads": "array of ThreadSnapshot"
   }
  }
 ],
 "errors": [
  {
   "id": "error:422-validation",
   "status": 422
  },
  {
   "id": "error:503-nemotron-unavailable",
   "status": 503
  }
 ],
 "externals": [
  {
   "id": "external:lmstudio-models",
   "probe": "curl -sS http://localhost:1234/api/v1/models",
   "capture": "captures/lmstudio-models.json",
   "notes": "Backend reads models[].key and models[].loaded_instances (non-empty = loaded). The UI-test mock serves this shape."
  },
  {
   "id": "external:lmstudio-chat-stream",
   "probe": "curl -sS -N -X POST http://localhost:1234/v1/chat/completions -H 'Content-Type: application/json' -d '{\"model\":\"qwen/qwen3.6-27b\",\"messages\":[{\"role\":\"user\",\"content\":\"/no_think Say hi in three words\"}],\"stream\":true}'",
   "capture": "captures/lmstudio-chat-stream.txt",
   "notes": "OpenAI chunk shape. Captured reality (2026-07-08): thinking arrives INLINE as <think>...</think> inside delta.content \u2014 this LM Studio config emits no reasoning_content. Think text therefore reaches the frontend through SSE 'token' events; the frontend must render it via the think toggle AND strip it from stored/POSTed history. The 'think' SSE event path (reasoning_content) remains contractually valid for configs that parse reasoning."
  }
 ],
