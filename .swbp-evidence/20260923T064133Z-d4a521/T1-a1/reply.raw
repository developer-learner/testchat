def save_thread_snapshot(thread: dict, expected_revision: int) -> int:
    with _lock:
        path = _data_path()
        threads, envelope = _read_threads_for_write(path)
        index = None
        for i, t in enumerate(threads):
            if t.get("id") == thread["id"]:
                index = i
                break
        current = _thread_revision(threads[index]) if index is not None else 0
        if current != expected_revision:
            raise SnapshotConflict(current)
        stored = {**thread, "revision": current + 1}
        if index is not None:
            threads[index] = stored
        else:
            threads.append(stored)
        _write_threads_locked(path, threads, envelope + 1)
        return current + 1


def delete_thread_snapshot(thread_id: int, expected_revision: int) -> bool:
    with _lock:
        path = _data_path()
        threads, envelope = _read_threads_for_write(path)
        index = None
        for i, t in enumerate(threads):
            if t.get("id") == thread_id:
                index = i
                break
        if index is None:
            return False
        current = _thread_revision(threads[index])
        if current != expected_revision:
            raise SnapshotConflict(current)
        del threads[index]
        _write_threads_locked(path, threads, envelope + 1)
        return True


