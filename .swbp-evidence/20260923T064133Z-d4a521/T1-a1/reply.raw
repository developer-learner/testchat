def _read_threads_for_write(path: str) -> tuple[list[dict], int]:
    if not os.path.exists(path):
        return [], 0
    data = _read_any(path)
    if isinstance(data, list):
        return list(data), 0
    if isinstance(data, dict) and isinstance(data.get("threads"), list):
        rev = data.get("revision")
        if isinstance(rev, int) and rev >= 0:
            return list(data["threads"]), rev
        return list(data["threads"]), 0
    raise SnapshotUnavailableError()


def _thread_revision(thread: dict) -> int:
    rev = thread.get("revision")
    if isinstance(rev, int) and rev >= 0:
        return rev
    return 0


def _write_threads_locked(path: str, threads: list[dict], revision: int) -> None:
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    payload = {"revision": revision, "threads": threads}
    fd, tmp_path = tempfile.mkstemp(dir=parent, suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, indent=2)
        bak_path = f"{path}.bak"
        if os.path.exists(path):
            try:
                shutil.copy2(path, bak_path)
            except OSError as exc:
                logger.warning(
                    "Could not back up snapshot: primary=%s backup=%s error=%s",
                    path,
                    bak_path,
                    exc,
                )
                raise
        os.replace(tmp_path, path)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError as cleanup_exc:
            logger.warning(
                "temp cleanup failed: temp=%s error=%s",
                tmp_path,
                cleanup_exc,
            )
        raise


