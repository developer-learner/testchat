  // --- ERD-DELTA v73: conflict handler — clear pending, latch page, write exact string ---
  function _handleConflict() {
=======
  function _doThreadMutation(entry) {
    var id = entry.payload.id;
    var body = { revision: _threadRevisions[id] || 0 };
    if (entry.type === 'THREAD_PUT') {
      body.thread = entry.payload.thread;
    }
    fetch('/api/v1/threads/' + id, {
      method: entry.type === 'THREAD_PUT' ? 'PUT' : 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (res) {
      if (res.status === 409) {
        return res.json().then(function () { _handleConflict(); });
      }
      if (!res.ok) {
        el('status-save').textContent = 'not saved';
        delete _savedThreads[id];
        _persistQueue.shift();
        _persistRunning = false;
        _drainPersistQueue();
        return;
      }
      return res.json().then(function (data) {
        if (entry.type === 'THREAD_PUT') {
          _threadRevisions[id] = data.revision;
        } else {
          delete _threadRevisions[id];
        }
        el('status-save').textContent = '';
        _persistQueue.shift();
        _persistRunning = false;
        _drainPersistQueue();
      });
    }).catch(function () {
      el('status-save').textContent = 'not saved';
      delete _savedThreads[id];
      _persistQueue.shift();
      _persistRunning = false;
      _drainPersistQueue();
    });
  }

