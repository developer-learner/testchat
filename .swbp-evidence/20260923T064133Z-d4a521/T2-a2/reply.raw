@router.put("/api/v1/threads/{thread_id}")
def put_thread(thread_id: int, payload: ThreadSavePayload):
    if payload.thread.id != thread_id:
        return JSONResponse(
            status_code=422, content={"detail": "thread id mismatch"}
        )
    thread = payload.thread.model_dump(exclude_none=True)
    thread.pop("revision", None)
    try:
        new_revision = save_thread_snapshot(thread, payload.revision)
    except SnapshotConflict as exc:
        return JSONResponse(
            status_code=409,
            content={
                "error": "revision_conflict",
                "current_revision": exc.current_revision,
            },
        )
    except SnapshotUnavailableError:
        return JSONResponse({"detail": "snapshot unavailable"}, status_code=503)
    return {"status": "ok", "revision": new_revision}


@router.delete("/api/v1/threads/{thread_id}")
def delete_thread(thread_id: int, body: ThreadsRevisionPrecondition | None = None):
    if body is None:
        return JSONResponse(
            status_code=422, content={"detail": "Missing required field: revision"}
        )
    try:
        delete_thread_snapshot(thread_id, body.revision)
    except SnapshotConflict as exc:
        return JSONResponse(
            status_code=409,
            content={
                "error": "revision_conflict",
                "current_revision": exc.current_revision,
            },
        )
    except SnapshotUnavailableError:
        return JSONResponse({"detail": "snapshot unavailable"}, status_code=503)
    return {"status": "ok"}
